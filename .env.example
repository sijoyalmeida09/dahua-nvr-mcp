# ============================================================
# NVR MCP Fleet — Environment Variables
# Copy to .env and fill real values. Do NOT commit .env.
# ============================================================

# --- Fleet-standard passwords (apply to ALL sites) ----------
# On-site admin: full control, LAN access
NVR_ADMIN_PASS=

# Remote monitoring user 'josho': viewer only, DDNS access
NVR_REMOTE_PASS=

# --- Legacy single-site override (optional) -----------------
# If sites.json is missing, these env vars are used as a
# single-site fallback (backward compatible with old .env).
NVR_HOST=192.168.1.100
NVR_USER=admin
NVR_PASS=
NVR_HTTP_PORT=80
NVR_RTSP_PORT=554
NVR_SITE=my-store
NVR_LAN_PREFIX=10.1.10
NVR_EXPECTED_IP_RANGE=50-64
